<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/image2" />


    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80040404" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="50dp"
            >

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="73dp"
                android:layout_height="68dp"
                android:contentDescription="App Logo"
                android:src="@drawable/logo1" />

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_marginLeft="10dp"
                android:fontFamily="@font/alex_brush"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="LuxeVista Resort"
                android:textColor="#FFFFFF"
                android:textSize="35sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAppTextOne"
            android:layout_marginTop="40dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elegance. Comfort. Experience"
            android:textColor="#FFFFFF"
            android:textSize="45sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAppTextTwo"
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elegance. Comfort. ExperienceYour Luxury Escape, Just a Tap Away"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />


        <Button
            android:id="@+id/btnLogin"
            android:layout_marginTop="200dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0B5194"
            app:strokeColor="#C5A358"
            app:strokeWidth="1dp"
            app:cornerRadius="24dp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvSignup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="Don't have an account? Sign Up"
            android:textColor="#FFFFFF"
            android:padding="10dp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</FrameLayout>